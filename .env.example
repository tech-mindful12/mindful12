# Railway injects PORT automatically. Locally, defaults to 3000.
PORT=3000

# Postgres connection string. On Railway set this to: ${{Postgres.DATABASE_URL}}
# For local dev without Postgres, use: DATABASE_URL=memory  (data is lost on restart)
DATABASE_URL=memory

# --- GoHighLevel ---
# Inbound webhook URL that receives every form submission
# (Automations > Workflow > "Inbound Webhook" trigger)
GHL_WEBHOOK_URL=
# Optional: separate inbound webhook for FAQ "ask us directly" questions (defaults to GHL_WEBHOOK_URL;
# the payload carries event: "faq_question" either way)
GHL_QUESTION_WEBHOOK_URL=
# Sub-account (location) ID
GHL_LOCATION_ID=
# Private Integration Token (Settings > Private Integrations) - used by the GHL API endpoints
GHL_PIT_TOKEN=

# --- Where people go after submitting ---
# 1. If they matched a registered company that has an Invite Link (set in the admin panel), they go there.
# 2. Otherwise, the redirect for their preview type:
REDIRECT_URL_INDEPENDENT=
REDIRECT_URL_HR=
REDIRECT_URL_EXECUTIVE=
REDIRECT_URL_EMPLOYEE=
# 3. Otherwise this generic fallback (blank = built-in thank-you card).
# All of these may contain placeholders: {id} {email} {preview_type} {company_id}
REDIRECT_URL=

# Community invite link included in the GHL webhook payload (invite_link) when nobody's
# registered company overrides it. Independent + HR have built-in defaults; set to override.
INVITE_LINK_INDEPENDENT=
INVITE_LINK_HR=
INVITE_LINK_EXECUTIVE=
INVITE_LINK_EMPLOYEE=

# Nobody is redirected until GHL has this contact's {{contact.private_channel_link}}.
# GHL posts it to /api/channel-link with this secret (falls back to ADMIN_API_KEY), and/or the app
# reads it off the contact when GHL_LOCATION_ID + GHL_PIT_TOKEN are set.
CHANNEL_LINK_SECRET=
CHANNEL_LINK_HOSTS=mindful12.com, *.mindful12.com
GHL_CHANNEL_LINK_FIELD_ID=ZVPibuKKScCRcqDQWFFL
GHL_CHANNEL_LINK_FIELD=private_channel_link

# Hosts allowed to iframe the form/admin and to be ?redirect= targets. Comma-separated; *.example.com matches subdomains.
# Default: mindful12.mycoursecreator360.com, mindful12.com, *.mindful12.com
ALLOWED_HOSTS=

# --- Admin panel (/admin) ---
# Password for the registered-companies admin panel. Sessions last 12h; changing it signs everyone out.
ADMIN_PASSWORD=
# Optional: lets scripts call the admin API with an X-Admin-Key header instead of signing in.
ADMIN_API_KEY=
