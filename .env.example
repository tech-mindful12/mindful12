# Railway injects PORT automatically. Locally, defaults to 3000.
PORT=3000

# Postgres connection string. On Railway set this to: ${{Postgres.DATABASE_URL}}
# For local dev without Postgres, use: DATABASE_URL=memory  (data is lost on restart)
DATABASE_URL=memory

# --- GoHighLevel ---
# Inbound webhook URL that receives every form submission
# (Automations > Workflow > "Inbound Webhook" trigger)
GHL_WEBHOOK_URL=
# Sub-account (location) ID
GHL_LOCATION_ID=
# Private Integration Token (Settings > Private Integrations) — used by the GHL API endpoints
GHL_PIT_TOKEN=

# Where to send people after a successful submission (leave blank to show the built-in thank-you card).
# Placeholders are filled in per submission: {id} {email} {preview_type} {company_id}
# e.g. https://yourfunnel.com/next-step?sid={id}&preview_type={preview_type}
REDIRECT_URL=

# Hosts allowed to iframe the form and to be ?redirect= targets. Comma-separated; *.example.com matches subdomains.
# Default: mindful12.mycoursecreator360.com, mindful12.com, *.mindful12.com
ALLOWED_HOSTS=

# Protects admin endpoints (POST /api/companies, GET /api/submissions). Leave blank to disable them.
ADMIN_API_KEY=
